# Local development: copy to `.env` (gitignored). `npm run dev` loads it into the API (every variable, no allowlist),
# and `npm run local` loads it too but then overrides ONLY its own values: DATABASE_URL, JWT_SECRET, ADMIN_EMAIL, PORT,
# PUBLIC_APP_URL, NODE_ENV, CRM_DEV_* and an EMPTY BREVO_API_KEY (a dev database never sends real email).
# Production (`npm start`, Docker, Coolify) never reads this file: set the variables in Coolify (see .env.production.example).
# Integration tests (`npm run test:*`) read `.env.test` instead, never this file (see .env.test.example).
# Variables already exported in your shell win over this file when running `npm run dev`.
NODE_ENV=development
PORT=3001
DATABASE_URL=postgres://hospeda:hospeda@localhost:5433/hospeda_leads
# 32+ random characters; example values are rejected by the server. Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-with-at-least-32-random-bytes
ADMIN_EMAIL=admin@example.com
# Leave empty locally: with a real key the app sends real email.
BREVO_API_KEY=
# Origin the browser uses (Vite in dev); POSTs from another origin are rejected.
PUBLIC_APP_URL=http://localhost:5173
# Brevo transactional webhook bearer token (32+ random characters); the webhook answers 503 without it.
BREVO_WEBHOOK_TOKEN=
# Where the client IP comes from for rate limiting: x-real-ip (default) | cf-connecting-ip | x-forwarded-for | none.
# Production uses cf-connecting-ip (domain behind the Cloudflare proxy); leave unset locally.
CRM_CLIENT_IP_HEADER=
# Slow-request log threshold in ms (default 1000).
SLOW_REQUEST_MS=
# Disabled unless the hash is configured. SHA-256 of a random base64url token (32+ bytes).
BUSINESS_IMPORT_TOKEN_SHA256=
# Optional existing administrator email for audit attribution; defaults to ADMIN_EMAIL.
BUSINESS_IMPORT_ACTOR_EMAIL=
# Cloudflare inbound email Worker bearer token (32+ random characters).
INBOUND_EMAIL_TOKEN=replace-with-a-random-token-of-at-least-32-characters
# Optional: enables replies to inbound emails through the dedicated Brevo SMTP key.
BREVO_SMTP_LOGIN=replace-with-brevo-smtp-login
BREVO_SMTP_KEY=replace-with-dedicated-crm-smtp-key
BREVO_SMTP_PORT=587
# Optional SMTP host override (default smtp-relay.brevo.com).
BREVO_SMTP_HOST=
# Meta Instagram Messaging webhook (receive-only).
INSTAGRAM_APP_SECRET=
INSTAGRAM_VERIFY_TOKEN=replace-with-a-random-token-of-at-least-32-characters
INSTAGRAM_ACCOUNT_ID=
# Base64 encoding of exactly 32 random bytes; required to store the account token encrypted.
INTEGRATION_SECRETS_KEY=
# Cloudflare R2 storage for sales material. Without all four, uploads answer "Almacenamiento no configurado".
# Use the DEV bucket locally (hospeda-crm-material-dev), never the production one.
R2_ACCOUNT_ID=replace-with-cloudflare-account-id
R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
R2_BUCKET=hospeda-crm-material-dev
# MCP server (OAuth-protected). Disabled unless CRM_MCP_ENABLED=1; not enabled in production. Needs a read-only DB role.
# CRM_MCP_ENABLED=1
# CRM_MCP_DATABASE_URL=postgres://READONLY_USER:PASSWORD@localhost:5433/hospeda_leads
# CRM_MCP_CLIENT_ID=replace-with-client-id
# CRM_MCP_CLIENT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
# CRM_MCP_TOKEN_SECRET=replace-with-a-random-secret-of-at-least-32-characters
# CRM_MCP_REDIRECT_URIS=https://chatgpt.com/connector_platform_oauth_redirect
