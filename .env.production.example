# Hospeda CRM production environment (Coolify). Names and placeholders only, never real values.
# Full inventory with the effect of each variable: docs/runbook-promocion-produccion.md §3.2 and docs/COOLIFY_DEPLOY.md.
# Coolify auto-deploys every push to main; load new variables BEFORE merging to main.

# Required: the server does not start without them.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/hospeda_leads
# At least 32 random characters (openssl rand -hex 32); placeholder-looking values are rejected.
JWT_SECRET=

# Needed in production: the server starts, but features fail without them.
PUBLIC_APP_URL=https://crm.hospeda.com.ar
ADMIN_EMAIL=admin@example.com
BREVO_API_KEY=
# 32+ characters; Bearer token of the Brevo transactional webhook.
BREVO_WEBHOOK_TOKEN=
# 32+ characters; the same value is a secret of the Cloudflare inbound-email worker.
INBOUND_EMAIL_TOKEN=
# Both needed for «Responder» by email.
BREVO_SMTP_LOGIN=
BREVO_SMTP_KEY=

# Instagram (webhook, token storage and the user script panel).
INSTAGRAM_APP_SECRET=
INSTAGRAM_ACCOUNT_ID=
# 32+ characters; the same value goes in the Meta callback configuration.
INSTAGRAM_VERIFY_TOKEN=
# Hospeda's Instagram @user, used by the user script panel.
INSTAGRAM_ACCOUNT_USERNAME=
# Base64 of exactly 32 bytes (openssl rand -base64 32). Keep a copy in the secrets manager.
INTEGRATION_SECRETS_KEY=

# Sales material storage (Cloudflare R2). Without all four the library shows «Almacenamiento no configurado».
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Business import API (only if used): SHA-256 of the token.
# BUSINESS_IMPORT_TOKEN_SHA256=
# BUSINESS_IMPORT_ACTOR_EMAIL=

# Client IP for the /m/* rate limit. Production sits behind the Cloudflare proxy.
CRM_CLIENT_IP_HEADER=cf-connecting-ip

# Optional, with code defaults.
NODE_ENV=production
PORT=3001
# BREVO_SMTP_PORT=587
# BREVO_SMTP_HOST=smtp-relay.brevo.com
# SLOW_REQUEST_MS=1000
# DB_LOCK_TIMEOUT_MS=10000
# DB_POOL_MAX=10
# DB_STATEMENT_TIMEOUT_MS=30000

# Do not set in production: CRM_MCP_* (MCP disabled), R2_ENDPOINT, CRM_TEST_DATABASE*, CRM_DEV_*, PERF_*, CRM_PERF_*,
# CRM_STATE_PREFLIGHT*, MIGRATION_DATA_URL / MIGRATION_DATA_KEY (one-time importer; remove if still present).
