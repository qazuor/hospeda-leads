# Integration tests: copy to `.env.test` (gitignored). `npm run test:*` and `npm run db:seed:test` load it via
# `node --env-file-if-exists=.env.test`. They NEVER load `.env`, and variables already exported in the shell (CI) win over this file.
#
# !!! DATABASE_URL MUST POINT TO A DISPOSABLE LOCAL DATABASE. The suites and the seed are DESTRUCTIVE and
# !!! CRM_TEST_DATABASE=1 is only a self-declaration: nothing checks where DATABASE_URL points. Never production data.
# Local Postgres on :5433: see docs/desarrollo-local.md.
CRM_TEST_DATABASE=1
DATABASE_URL=postgres://hospeda:hospeda@127.0.0.1:5433/hospeda_leads
# 32+ random characters (example values are rejected by the server).
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
ADMIN_EMAIL=admin@example.com
# Always empty in tests: never send real email.
BREVO_API_KEY=
PUBLIC_APP_URL=http://localhost:5173
# Test-only variables (leave unset unless you need them).
# R2 endpoint override used by the storage tests.
# R2_ENDPOINT=
# Browser suite (npm run test:browser): path of a Chromium/Chrome binary instead of the Playwright one.
# CRM_BROWSER_EXECUTABLE=
