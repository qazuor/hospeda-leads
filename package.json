    "test:communication": "node --env-file-if-exists=.env.test scripts/test-communication-migration.mjs && node --env-file-if-exists=.env.test scripts/test-communication-product-migration.mjs && node --env-file-if-exists=.env.test scripts/test-message-catalog-migration.mjs && node --env-file-if-exists=.env.test --import tsx scripts/test-communication.ts && DB_LOCK_TIMEOUT_MS=2000 node --env-file-if-exists=.env.test --import tsx scripts/test-communication-locks.ts",
    "test:inbound": "node --env-file-if-exists=.env.test --import tsx scripts/test-inbound-email.ts && node --env-file-if-exists=.env.test --import tsx scripts/test-inbound-email-ui.ts && node --env-file-if-exists=.env.test --import tsx scripts/test-inbound-unmatched.ts && node --env-file-if-exists=.env.test --import tsx scripts/test-inbound-email-reply.ts && node --env-file-if-exists=.env.test --import tsx scripts/test-email-uncertain.ts && node --env-file-if-exists=.env.test --import tsx scripts/test-userscript.ts && node --env-file-if-exists=.env.test --import tsx scripts/test-userscript-material-file.ts",
    "test:instagram": "node --env-file-if-exists=.env.test scripts/test-instagram-opened-migration.mjs && node --env-file-if-exists=.env.test --import tsx scripts/test-instagram.ts && node --env-file-if-exists=.env.test --import tsx scripts/test-instagram-open-chat.ts",
    "test:inbox": "node --env-file-if-exists=.env.test --import tsx scripts/test-inbox.ts",
    "test:communication-reads": "node --env-file-if-exists=.env.test --import tsx scripts/test-communication-reads.ts",
    "test:email-engagement": "node --env-file-if-exists=.env.test --import tsx scripts/test-email-engagement.ts",
    "test:usability": "node --env-file-if-exists=.env.test --import tsx scripts/test-usability.ts",
    "test:permissions": "node --env-file-if-exists=.env.test --import tsx scripts/test-permissions.ts",
    "build:message-catalog": "node --import tsx scripts/build-message-catalog-migration.ts",
    "db:audit:managements": "node scripts/audit-management-cleanup.mjs",
    "test:mcp": "node --env-file-if-exists=.env.test --import tsx scripts/test-mcp.ts",
    "test:managements": "node --env-file-if-exists=.env.test scripts/test-explicit-management-migration.mjs && node --env-file-if-exists=.env.test --import tsx scripts/test-explicit-management.ts",
    "test:view-pins": "node --env-file-if-exists=.env.test --import tsx scripts/test-view-pins.ts",
    "test:sales-material": "node --env-file-if-exists=.env.test --import tsx scripts/test-sales-material.ts",
    "test:sales-material-share": "node --env-file-if-exists=.env.test --import tsx scripts/test-sales-material-share.ts",
    "test:sales-material-composer": "node --env-file-if-exists=.env.test --import tsx scripts/test-sales-material-composer.ts",
    "test:sales-material-templates": "node --env-file-if-exists=.env.test --import tsx scripts/test-sales-material-templates.ts",
    "test:sales-material-verticals": "node --env-file-if-exists=.env.test --import tsx scripts/test-sales-material-verticals.ts",
    "db:recover:businesses": "node scripts/recover-business-metadata.mjs"
  },
