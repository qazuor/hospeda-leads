NODE_ENV=development
PORT=3001
DATABASE_URL=postgres://hospeda:hospeda@localhost:5432/hospeda_leads
JWT_SECRET=change-me-with-at-least-32-random-bytes
ADMIN_EMAIL=admin@example.com
BREVO_API_KEY=
PUBLIC_APP_URL=http://localhost:3001
# Disabled unless the hash is configured. SHA-256 of a random base64url token (32+ bytes).
BUSINESS_IMPORT_TOKEN_SHA256=
# Optional existing administrator email for audit attribution; defaults to ADMIN_EMAIL.
BUSINESS_IMPORT_ACTOR_EMAIL=
# Cloudflare inbound email Worker bearer token (32+ random characters).
INBOUND_EMAIL_TOKEN=replace-with-a-random-token-of-at-least-32-characters
# Optional: enables replies to inbound emails through the dedicated Brevo SMTP key.
BREVO_SMTP_LOGIN=replace-with-brevo-smtp-login
BREVO_SMTP_KEY=replace-with-dedicated-crm-smtp-key
BREVO_SMTP_PORT=587
# Meta Instagram Messaging webhook (receive-only).
INSTAGRAM_APP_SECRET=
INSTAGRAM_VERIFY_TOKEN=replace-with-a-random-token-of-at-least-32-characters
INSTAGRAM_ACCOUNT_ID=
# Base64 encoding of exactly 32 random bytes; required to store the account token encrypted.
INTEGRATION_SECRETS_KEY=
