{
  "name": "hospeda-leads",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api \"vite\" \"tsx watch src/server/index.ts\"",
    "build": "vite build && tsup src/server/index.ts --format esm --platform node --out-dir dist-server --clean",
    "start": "node dist-server/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "node scripts/migrate.mjs",
    "db:seed:test": "node scripts/seed-test.mjs",
    "db:import": "node scripts/import-data.mjs",
    "db:validate": "node scripts/validate-data.mjs",
    "db:migrate:floot": "node scripts/migrate-floot-snapshot.mjs"
  },
